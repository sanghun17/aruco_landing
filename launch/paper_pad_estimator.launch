<launch>
  <arg name="image_topic" default="/landing/camera/image_raw"/>
  <arg name="camera_info_topic" default="/landing/camera/camera_info"/>
  <arg name="pad_size_m" default="0.70"/>
  <arg name="layout_file" default="$(find aruco_landing)/config/paper_pad_layout.yaml"/>
  <arg name="dictionary" default="DICT_4X4_100"/>
  <arg name="publish_debug_image" default="false"/>
  <arg name="body_frame" default="base_link"/>

  <rosparam command="load" file="$(find aruco_landing)/config/paper_pad_estimator.yaml"
            ns="paper_pad_estimator"/>
  <node pkg="aruco_landing" type="paper_pad_estimator_node"
        name="paper_pad_estimator" output="screen" required="true">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="pad_size_m" value="$(arg pad_size_m)"/>
    <param name="layout_file" value="$(arg layout_file)"/>
    <param name="dictionary" value="$(arg dictionary)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>
  </node>
  <node pkg="aruco_landing" type="pad_relative_vehicle_state.py"
        name="pad_relative_vehicle_state" output="screen" required="true">
    <param name="body_frame" value="$(arg body_frame)"/>
    <param name="camera_pose_topic" value="/landing/camera_pose_pad"/>
  </node>
</launch>
