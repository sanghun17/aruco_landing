<launch>
  <arg name="config_root" default="/work/stacks/aruco-landing-jetson/config"/>
  <!-- Named calibrated pads. Explicit pad_configuration still overrides this selection. -->
  <arg name="pad" default="legacy" doc="legacy, baseline (61-marker), b2 (700mm printed hybrid), random/a1 (700mm A1 random), proposed1"/>
  <arg name="pad_configuration" default="$(eval {'legacy': arg('config_root') + '/physical_pad.yaml', 'baseline': find('aruco_landing') + '/config/paper_pad_layout_physical_20260920_runtime.yaml', 'b2': find('aruco_landing') + '/config/baseline_b2_700mm_runtime.yaml', 'random': find('aruco_landing') + '/config/random_a1_700mm_runtime.yaml', 'a1': find('aruco_landing') + '/config/random_a1_700mm_runtime.yaml', 'proposed1': find('aruco_landing') + '/config/proposed_pad_1_layout_physical_20260920_runtime.yaml'}[arg('pad')])"/>
  <arg name="image_topic" default="/landing/camera/image_raw"/>
  <arg name="camera_info_topic" default="/landing/camera/camera_info"/>
  <arg name="mocap_topic" default="/vrpn_client_node/pure/pose"/>
  <arg name="detected_image_rate_hz" default="10"/>
  <arg name="processing_width" default="720"/>
  <arg name="processing_height" default="720"/>
  <arg name="estimate_rate_hz" default="60"/>
  <arg name="gravity_constraint" default="$(optenv LANDING_GRAVITY_CONSTRAINT false)"/>
  <arg name="level_pad" default="$(optenv LANDING_LEVEL_PAD false)"/>
  <arg name="attitude_topic" default="/mavros/imu/data"/>
  <arg name="adaptive_threshold_min" default="$(optenv LANDING_ADAPTIVE_THRESHOLD_MIN 7)"/>
  <arg name="adaptive_threshold_max" default="$(optenv LANDING_ADAPTIVE_THRESHOLD_MAX 27)"/>
  <arg name="adaptive_threshold_step" default="$(optenv LANDING_ADAPTIVE_THRESHOLD_STEP 20)"/>
  <node pkg="aruco_landing" type="physical_pad_estimator.py" name="physical_pad_estimator" output="screen" required="true">
    <param name="processing_width" value="$(arg processing_width)"/>
    <param name="processing_height" value="$(arg processing_height)"/>
    <param name="pad_configuration" value="$(arg pad_configuration)"/>
    <param name="body_camera_calibration" value="$(arg config_root)/calibration/20260919/base_link_to_see3cam_optical_frame.yaml"/>
    <param name="time_alignment" value="$(arg config_root)/calibration/20260919/time_alignment.yaml"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="mocap_topic" value="$(arg mocap_topic)"/>
    <param name="detected_image_rate_hz" value="$(arg detected_image_rate_hz)"/>
    <param name="estimate_rate_hz" value="$(arg estimate_rate_hz)"/>
    <param name="gravity_constraint" value="$(arg gravity_constraint)"/>
    <param name="level_pad" value="$(arg level_pad)"/>
    <param name="attitude_topic" value="$(arg attitude_topic)"/>
    <param name="adaptive_threshold_min" value="$(arg adaptive_threshold_min)"/>
    <param name="adaptive_threshold_max" value="$(arg adaptive_threshold_max)"/>
    <param name="adaptive_threshold_step" value="$(arg adaptive_threshold_step)"/>
  </node>
</launch>
